# ===== 上游 AmazingData SDK 服务器凭据 =====
# SDK 登录连接的目标服务器（你订阅的数据源），非本服务监听地址
AMAZINGDATA_USERNAME=
AMAZINGDATA_PASSWORD=
AMAZINGDATA_HOST=
AMAZINGDATA_PORT=

# ===== 本服务 HTTP 监听地址 =====
# 本地模式（scripts/run.py 模式 1）下生效，传给 uvicorn。
# Docker 模式下无效——Dockerfile CMD 写死了 0.0.0.0:3021，未读取此处。
# 如需 Docker 模式支持自定义端口，需同步修改 Dockerfile CMD 与 docker-compose.yml 的 ports。
# HTTP_HOST=0.0.0.0 表示监听所有网卡（容器内必须如此）；仅本机访问可改 127.0.0.1
HTTP_HOST=0.0.0.0
HTTP_PORT=3021
