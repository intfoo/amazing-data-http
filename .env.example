# ===== 上游 AmazingData SDK 服务器凭据 =====
# SDK 登录连接的目标服务器（你订阅的数据源），非本服务监听地址
AMAZINGDATA_USERNAME=
AMAZINGDATA_PASSWORD=
AMAZINGDATA_HOST=
AMAZINGDATA_PORT=

# ===== 本服务 HTTP 监听地址 =====
# 本地模式（scripts/run.py 模式 1）下生效，传给 uvicorn。
# Docker 模式下无效——Dockerfile CMD 写死了 0.0.0.0:3021，未读取此处。
# 如需 Docker 模式支持自定义端口，需同步修改 Dockerfile CMD 与 docker-compose.yml 的 ports。
# HTTP_HOST=0.0.0.0 表示监听所有网卡（容器内必须如此）；仅本机访问可改 127.0.0.1
HTTP_HOST=0.0.0.0
HTTP_PORT=3021

# ===== SDK 并发限制 =====
# 最大并发 SDK 调用数，超出返回 503 SERVICE_BUSY。默认 5。
# SDK_MAX_CONCURRENT=5

# ===== Bearer Token 认证 =====
# 客户端访问 /daily /minute /adj_factor /realtime 必须带
# Authorization: Bearer <AUTH_TOKEN> 头。/health 不需要认证。
# AUTH_TOKEN 强度要求：长度 > 12 且同时含字母和数字。
#
# 在本地模式与 Docker 模式下均生效（docker-compose.yml 通过 env_file: .env 注入容器），
# 与 HTTP_HOST 不同（后者在 Docker 模式下被 Dockerfile CMD 覆盖）。
AUTH_TOKEN=

# 是否启用认证（默认 true）。
# false 时认证彻底关闭，所有请求直接放行，AUTH_TOKEN 字段被忽略。
# 仅本地调试用，生产环境必须保持 true。
AUTH_REQUIRED=true

# ===== 复权因子本地缓存基目录 =====
# SDK get_adj_factor 的 local_path，is_local=False 时仍会更新此目录缓存。
# SDK 内部用字符串拼接构造缓存路径（local_path + 'basedata/adj_factor/'，非 os.path.join），
# 因此 local_path 末尾必须带分隔符，否则 'data/adj_factor' + 'basedata' → 'adj_factorbasedata'。
# gateway.py 会强制末尾补 '/'，但建议配置时就写全（手册示例 'D://AmazingData_local_data//'）。
# SDK 会在 local_path 下自建 basedata/adj_factor/ 子目录，无需在此预设 adj_factor 后缀。
# 容器内固定为 /app/data/，与 docker-compose.yml 的 volumes 挂载点 ./data:/app/data 对齐。
# 本地模式可留空（代码会兜底用项目根 data/）。
ADJ_FACTOR_LOCAL_PATH=/app/data/

# ===== 复权因子缓存读取模式 =====
# SDK get_adj_factor 的 is_local 参数：
# false（默认）：每次从服务端取最新数据（~21s/次），仍会更新本地缓存。数据保证最新。
# true：本地有缓存则读本地（<1s），本地无则远程取 + 写本地（首次 ~21s）。
#       加速重复查询，但本地缓存可能陈旧（adj_factor 除权事件一年几次，风险低但不为零）。
#       需要刷新时删除 data/basedata/adj_factor/ 目录，下次查询会重新远程拉取。
#ADJ_FACTOR_IS_LOCAL=false

# ===== 实时订阅窗口与存活检测 =====
# 仅在交易日 [SUBSCRIPTION_OPEN, SUBSCRIPTION_CLOSE] 时段内启动快照订阅，
# 非交易时段不持有订阅会话以降 CPU（每日省 ~16h×1 核）。SDK 查询接口（/daily /minute /adj_factor）不受影响。
# 格式 HH:MM，默认覆盖 A 股交易时段（含集合竞价 09:15-09:25）。
#SUBSCRIPTION_OPEN=09:00
#SUBSCRIPTION_CLOSE=15:20
#
# watchdog 失活阈值（秒）：窗口期内连续 N 秒未收到快照即判定订阅失活，
# /health 返回 503 触发容器重启。盘中快照约 3s/轮，90s≈30 轮无数据。
#STALE_THRESHOLD_SEC=90
#
# watchdog 检查间隔（秒），Event.wait 实现，可被 stop_watchdog 立即唤醒。
#WATCHDOG_INTERVAL_SEC=60